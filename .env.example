# ==============================================================================
# PREPSKM.IN — Vercel & AI Studio Server-Only AI Provider Secrets (All 8 Keys)
# Configure these in Vercel Environment Variables & AI Studio Secrets
# IMPORTANT: Never prefix private AI API keys with VITE_ (they stay server-only).
# Automatic failover: Groq -> Gemini -> Mistral (pool) -> DeepSeek -> OpenRouter -> Workers AI
# ==============================================================================
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
MISTRAL_API_KEYS=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_TOKEN=

# ==============================================================================
# Public Client-Safe Vite Build Variables (Zero Secrets)
# Leave VITE_API_BASE_URL blank on Vercel so /api/* routes hit same-origin
# Vercel Serverless Functions cleanly with zero CORS or 404 issues.
# ==============================================================================
VITE_API_BASE_URL=
VITE_SITE_URL=https://prepskm.in
VITE_GOOGLE_CLIENT_ID=
