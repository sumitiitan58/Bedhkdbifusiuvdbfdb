# Preps AI Individual Provider API Keys
# Configure each key separately in Cloudflare Pages Environment Variables / AI Studio Secrets
# (never combine keys into comma-separated variables).
# Automatic failover order: Groq -> Gemini -> DeepSeek -> OpenRouter -> Mistral -> Cloudflare Workers AI
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_WORKERS_AI_API_KEY=
DEEPSEEK_API_KEY=

# Optional: Cloudflare Account ID required when calling Cloudflare Workers AI via REST API
# (not needed if using a native Cloudflare Pages `AI` binding)
CLOUDFLARE_ACCOUNT_ID=

# Frontend Vite Build Variables (Configure in Cloudflare Pages -> Settings -> Environment Variables)
# Leave VITE_API_BASE_URL blank for same-origin Cloudflare Pages Functions (/api/*).
# Only set VITE_API_BASE_URL if hosting the API backend on a separate domain (e.g. https://api.prepskm.in).
VITE_API_BASE_URL=
VITE_SITE_URL=https://prepskm.in
VITE_GOOGLE_CLIENT_ID=
