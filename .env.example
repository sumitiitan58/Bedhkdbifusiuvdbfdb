# ==============================================================================
# PREPSKM.IN — Vercel Server-Only AI Provider Secrets
# Configure these in Vercel Dashboard -> Project Settings -> Environment Variables
# IMPORTANT: Never prefix private AI API keys with VITE_ (they stay server-only).
# Automatic failover order: Groq -> Gemini -> DeepSeek -> OpenRouter -> Mistral
# ==============================================================================
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# ==============================================================================
# Public Client-Safe Vite Build Variables (Zero Secrets)
# Leave VITE_API_BASE_URL blank on Vercel so /api/* routes hit same-origin
# Vercel Serverless Functions cleanly with zero CORS or 404 issues.
# ==============================================================================
VITE_API_BASE_URL=
VITE_SITE_URL=https://prepskm.in
VITE_GOOGLE_CLIENT_ID=
