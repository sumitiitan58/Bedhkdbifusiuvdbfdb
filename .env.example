# Preps AI Multi-Provider Keys (Cloudflare Pages Environment Variables / local .dev.vars)
# Supports comma-separated multiple keys for automatic key rotation
# Provider order: Groq -> Gemini -> OpenRouter -> Mistral
GROQ_API_KEYS=
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=
MISTRAL_API_KEYS=

# Single-key fallbacks (also supported alongside *_API_KEYS)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
